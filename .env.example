# Copy this file to .env and fill in values. Never commit .env.

# LLM interpretation. Leave ANTHROPIC_API_KEY empty to use the labelled rule-based fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=15

# Database. Relative paths are resolved from the project root.
DATABASE_PATH=data/sales.db

# Frontend -> backend
API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501